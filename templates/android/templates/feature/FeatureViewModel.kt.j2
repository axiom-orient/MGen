     */
    public fun onAction(action: {{ feature_name }}Action) {
        when (action) {
            is {{ feature_name }}Action.Refresh -> loadData()
            is {{ feature_name }}Action.OnItemClicked -> handleItemClick(action.id)
            is {{ feature_name }}Action.OnBackClicked -> handleBackNavigation()
        }
