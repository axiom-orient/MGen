/**
 * ViewModel for {{ feature_name }} feature implementing MVI pattern.
 *
 * Manages UI state and business logic using the Model-View-Intent (MVI) architecture.
 * Provides unidirectional data flow with State, Action (Intent), and SideEffect.
 *
 * ## MVI Architecture
 * - **State**: Immutable data class representing UI state
 * - **Action**: Sealed interface defining all possible user intents
 * - **SideEffect**: One-time events like navigation or toast messages
 *
 * ## State Management
 * ```
 * User Action → onAction() → Business Logic → State Update → UI Recomposition
 *                           ↓
 *                      Side Effect (optional)
 * ```
 *
 * ## Features
 * - **Reactive State**: StateFlow for UI observation with lifecycle awareness
 * - **Side Effects**: Channel-based events for navigation and one-time actions
 * - **Structured Concurrency**: ViewModelScope for automatic cancellation
 * - **Error Handling**: Graceful error recovery with error state
 * - **Process Death**: SavedStateHandle for state restoration
 *
 * ## Usage in Composable
 * ```kotlin
 * @Composable
 * fun {{ feature_name }}Screen(viewModel: {{ feature_name }}ViewModel = hiltViewModel()) {
 *     val state by viewModel.state.collectAsStateWithLifecycle()
 *
 *     LaunchedEffect(key1 = Unit) {
 *         viewModel.sideEffect.collect { effect ->
 *             when (effect) {
 *                 is {{ feature_name }}SideEffect.NavigateBack -> navController.popBackStack()
 *                 is {{ feature_name }}SideEffect.ShowError -> showSnackbar(effect.message)
 *             }
 *         }
 *     }
 *
 *     {{ feature_name }}Content(
 *         state = state,
 *         onAction = viewModel::onAction
 *     )
 * }
 * ```
 *
 * @param savedStateHandle Saved state handle for process death recovery
 *
 * @see {{ feature_name }}State
 * @see {{ feature_name }}Action
 * @see {{ feature_name }}SideEffect
 */
