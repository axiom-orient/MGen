/**
 * {{ feature_name }} Screen
 */
@Composable
public fun {{ feature_name }}Screen(
    viewModel: {{ feature_name }}ViewModel = hiltViewModel(),
    onNavigateBack: () -> Unit
) {
    val state by viewModel.state.collectAsStateWithLifecycle()
    val sideEffect = viewModel.sideEffect

    LaunchedEffect(sideEffect) {
        sideEffect.collect { effect ->
            when (effect) {
                is {{ feature_name }}SideEffect.NavigateBack -> onNavigateBack()
                is {{ feature_name }}SideEffect.ShowError -> {
                    // Show snackbar or toast
                }
            }
        }
    }

    {{ feature_name }}Content(
        state = state,
        onAction = viewModel::onAction
    )
}

@Composable
public fun {{ feature_name }}Content(
    state: {{ feature_name }}State,
    onAction: ({{ feature_name }}Action) -> Unit
) {
    Scaffold { paddingValues ->
        Box(
            modifier = Modifier
                .fillMaxSize()
                .padding(paddingValues),
            contentAlignment = Alignment.Center
        ) {
            when {
                state.isLoading -> {
                    CircularProgressIndicator()
                }
                state.error != null -> {
                    Column(
                        horizontalAlignment = Alignment.CenterHorizontally
                    ) {
                        Text(
                            text = "Error: ${state.error}",
                            color = MaterialTheme.colorScheme.error
                        )
                        Button(
                            onClick = { onAction({{ feature_name }}Action.Refresh) },
                            modifier = Modifier.padding(top = 16.dp)
                        ) {
                            Text("Retry")
                        }
                    }
                }
                else -> {
                    Column(
                        horizontalAlignment = Alignment.CenterHorizontally
                    ) {
                        Text(
                            text = state.data.firstOrNull() ?: "No data",
                            style = MaterialTheme.typography.headlineMedium
                        )
                        Button(
                            onClick = { onAction({{ feature_name }}Action.OnItemClicked("123")) },
                            modifier = Modifier.padding(top = 16.dp)
                        ) {
                            Text("Test Navigation")
                        }
                    }
                }
            }
        }
    }
}

