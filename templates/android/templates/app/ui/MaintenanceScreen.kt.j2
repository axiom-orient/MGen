/**
 * Maintenance screen displayed during server maintenance periods.
 *
 * Blocks all app functionality when the server is under maintenance.
 * Shows a localized maintenance message and allows users to check if maintenance is complete.
 *
 * ## Features
 * - **Localized Message**: Displays maintenance message from Remote Config
 * - **Refresh Button**: Allows users to retry and check maintenance status
 * - **Highest Priority**: Overrides ForceUpdate and other error states
 * - **Graceful Blocking**: Prevents app usage without crashing
 *
 * ## Priority Order
 * AppLifecycleManager checks states in this order:
 * 1. **Maintenance** ← Highest priority (this screen)
 * 2. ForceUpdate
 * 3. Error
 * 4. Ready
 *
 * ## Maintenance Flow
 * 1. Remote Config sets `maintenance_mode_enabled = true`
 * 2. App fetches config during cold start or foreground return
 * 3. AppState detects maintenance mode
 * 4. This screen is shown immediately
 * 5. User taps "Refresh" → Re-fetches Remote Config
 * 6. If maintenance ended, app proceeds to Ready state
 *
 * ## Remote Config Keys
 * ```json
 * {
 *   "maintenance_mode_enabled": true,
 *   "maintenance_message": "{\"en\": \"Under maintenance...\", \"ko\": \"점검 중...\"}"
 * }
 * ```
 *
 * ## Customization
 * Update the accent color to match your brand:
 * ```kotlin
 * // Accent color for icon and button
 * Color(0xFF607D8B)  // Blue-grey
 * ```
 *
 * @param state Maintenance state containing localized message
 * @param onRefresh Callback to retry cold start and check if maintenance ended
 * @param modifier Modifier for the root container
 *
 * @see AppStartupState.Maintenance
 * @see AppLifecycleManager.retry
 */
@Composable
public fun MaintenanceScreen(
    state: AppStartupState.Maintenance,
    onRefresh: () -> Unit,
    modifier: Modifier = Modifier
) {
    Column(
        modifier = modifier
            .fillMaxSize()
            .background(Color.White)
            .padding(40.dp),
        horizontalAlignment = Alignment.CenterHorizontally,
        verticalArrangement = Arrangement.Center
    ) {
        // Maintenance Icon
        Icon(
            imageVector = Icons.Filled.Build,
            contentDescription = null,
            tint = Color(0xFF607D8B),
            modifier = Modifier.size(80.dp)
        )

        Spacer(modifier = Modifier.height(32.dp))

        // Title
        Text(
            text = "Under Maintenance",
            style = MaterialTheme.typography.headlineSmall.copy(
                fontWeight = FontWeight.Bold
            ),
            textAlign = TextAlign.Center
        )

        Spacer(modifier = Modifier.height(16.dp))

        // Message
        Text(
            text = state.message.ifEmpty { "We're currently performing maintenance. Please check back soon." },
            style = MaterialTheme.typography.bodyLarge.copy(
                color = Color(0xFF666666)
            ),
            textAlign = TextAlign.Center
        )

        Spacer(modifier = Modifier.height(48.dp))

        // Refresh Button
        Button(
            onClick = onRefresh,
            modifier = Modifier
                .fillMaxWidth()
                .height(56.dp),
            shape = RoundedCornerShape(12.dp),
            colors = ButtonDefaults.buttonColors(
                containerColor = Color(0xFF607D8B)
            )
        ) {
            Text(
                text = "Refresh",
                style = MaterialTheme.typography.bodyLarge.copy(
                    fontWeight = FontWeight.Bold,
                    color = Color.White
                )
            )
        }
    }
}

