/**
 * Animated splash screen with scale and fade animations.
 *
 * Displays the app logo, name, and loading progress during app initialization.
 * Implements smooth entrance animations to enhance user experience during cold start.
 *
 * ## Features
 * - **Scale Animation**: Logo scales from 0.5x to 1.0x over 800ms
 * - **Fade Animation**: Content fades in with 600ms delay for staggered effect
 * - **Gradient Background**: Linear gradient for visual appeal
 * - **Loading States**: Shows progress indicator for Loading state, static for Splash
 * - **Loading Message**: Displays status message when available
 *
 * ## Animation Sequence
 * 1. Logo scales up with FastOutSlowInEasing (800ms)
 * 2. Text fades in with 200ms delay (600ms duration)
 * 3. Progress indicator appears with content
 *
 * ## Customization
 * Replace the gradient colors and app icon to match your brand:
 * ```kotlin
 * // Background gradient colors
 * Color(0xFFFAF8F6) to Color(0xFFF2EDEA)  // Warm neutral
 *
 * // Accent color (logo background & progress indicator)
 * Color(0xFFE66B5B)  // Coral red
 * ```
 *
 * @param startupState Current startup state from AppLifecycleManager
 * @param modifier Modifier for the root container
 *
 * @see AppStartupState.Splash
 * @see AppStartupState.Loading
 */
@Composable
public fun SplashScreen(
    startupState: AppStartupState,
    modifier: Modifier = Modifier
) {
    // Animation states for entrance effects
    val scale = remember { Animatable(0.5f) }
    val alpha = remember { Animatable(0f) }

    // Scale animation: Logo scales from 0.5x to 1.0x with smooth easing
    LaunchedEffect(key1 = Unit) {
        scale.animateTo(
            targetValue = 1f,
            animationSpec = tween(
                durationMillis = 800,
                easing = FastOutSlowInEasing
            )
        )
    }

    // Fade animation: Content fades in with slight delay for staggered effect
    LaunchedEffect(key1 = Unit) {
        alpha.animateTo(
            targetValue = 1f,
            animationSpec = tween(
                durationMillis = 600,
                delayMillis = 200
            )
        )
    }

    Box(
        modifier = modifier
            .fillMaxSize()
            .background(
                brush = Brush.linearGradient(
                    colors = listOf(
                        Color(0xFFFAF8F6),
                        Color(0xFFF2EDEA)
                    )
                )
            ),
        contentAlignment = Alignment.Center
    ) {
        Column(
            horizontalAlignment = Alignment.CenterHorizontally,
            verticalArrangement = Arrangement.Center
        ) {
            // App Icon
            Box(
                modifier = Modifier
                    .scale(scale.value)
                    .size(100.dp)
                    .background(
                        brush = Brush.linearGradient(
                            colors = listOf(
                                Color(0xFFE66B5B),
                                Color(0xFFCC4D3D)
                            )
                        ),
                        shape = RoundedCornerShape(20.dp)
                    ),
                contentAlignment = Alignment.Center
            ) {
                Icon(
                    imageVector = Icons.Filled.Widgets,
                    contentDescription = null,
                    tint = Color.White,
                    modifier = Modifier.size(48.dp)
                )
            }

            Spacer(modifier = Modifier.height(32.dp))

            // App Name
            Text(
                text = "{{ cookiecutter.project_name }}".uppercase(),
                style = MaterialTheme.typography.headlineMedium.copy(
                    fontWeight = FontWeight.Black,
                    letterSpacing = 2.sp,
                    color = Color(0xFFE66B5B)
                ),
                modifier = Modifier.alpha(alpha.value)
            )

            Spacer(modifier = Modifier.height(8.dp))

            // Subtitle
            Text(
                text = "Powered by {{ cookiecutter.project_name }}",
                style = MaterialTheme.typography.bodyMedium.copy(
                    color = Color(0xFF666666)
                ),
                modifier = Modifier.alpha(alpha.value * 0.8f)
            )

            Spacer(modifier = Modifier.height(48.dp))

            // Loading indicator
            when (startupState) {
                is AppStartupState.Splash,
                is AppStartupState.Loading -> {
                    CircularProgressIndicator(
                        modifier = Modifier
                            .size(32.dp)
                            .alpha(alpha.value),
                        color = Color(0xFFE66B5B),
                        strokeWidth = 3.dp
                    )

                    if (startupState is AppStartupState.Loading) {
                        Spacer(modifier = Modifier.height(16.dp))
                        Text(
                            text = startupState.message,
                            style = MaterialTheme.typography.bodySmall.copy(
                                color = Color(0xFF999999)
                            ),
                            modifier = Modifier.alpha(alpha.value)
                        )
                    }
                }
                else -> { /* No indicator */ }
            }
        }
    }
}

@Preview(showBackground = true)
@Composable
private fun SplashScreenPreview() {
    SplashScreen(startupState = AppStartupState.Loading(0.5f, "Loading..."))
}
