/**
 * Force update screen that blocks app usage until user updates.
 *
 * Displayed when the current app version is below the minimum required version
 * specified in Remote Config. Prevents app usage to ensure users are on supported versions.
 *
 * ## Features
 * - **Version Comparison**: Shows current vs required version
 * - **Direct Store Link**: Button opens Play Store for seamless update
 * - **Non-Dismissible**: Blocks all app functionality until update
 * - **Priority**: Lower than Maintenance mode, higher than normal errors
 *
 * ## Update Flow
 * 1. User launches app
 * 2. Remote Config fetch determines minimum version requirement
 * 3. UpdateChecker compares current version with minimum required
 * 4. If outdated, this screen is shown
 * 5. User taps "Update" → Play Store opens
 * 6. After update, app restarts with new version
 *
 * ## Version Format
 * Supports semantic versioning (semver): MAJOR.MINOR.PATCH
 * - Example: "2.1.0" > "1.9.5"
 * - Comparison logic in UpdateChecker.kt
 *
 * ## Customization
 * Update the accent color and icon to match your brand:
 * ```kotlin
 * // Accent color for icon and button
 * Color(0xFFFF9800)  // Orange (warning color)
 * ```
 *
 * @param state Force update state with version info and store URL
 * @param modifier Modifier for the root container
 *
 * @see AppStartupState.ForceUpdate
 * @see UpdateChecker
 */
@Composable
public fun ForceUpdateScreen(
    state: AppStartupState.ForceUpdate,
    modifier: Modifier = Modifier
) {
    val context = LocalContext.current

    Column(
        modifier = modifier
            .fillMaxSize()
            .background(Color.White)
            .padding(40.dp),
        horizontalAlignment = Alignment.CenterHorizontally,
        verticalArrangement = Arrangement.Center
    ) {
        // Update Icon
        Icon(
            imageVector = Icons.Filled.SystemUpdate,
            contentDescription = null,
            tint = Color(0xFFFF9800),
            modifier = Modifier.size(80.dp)
        )

        Spacer(modifier = Modifier.height(32.dp))

        // Title
        Text(
            text = stringResource(R.string.force_update_title),
            style = MaterialTheme.typography.headlineSmall.copy(
                fontWeight = FontWeight.Bold
            ),
            textAlign = TextAlign.Center
        )

        Spacer(modifier = Modifier.height(16.dp))

        // Description
        Text(
            text = stringResource(R.string.force_update_description, state.requiredVersion, state.currentVersion),
            style = MaterialTheme.typography.bodyLarge.copy(
                color = Color(0xFF666666)
            ),
            textAlign = TextAlign.Center
        )

        Spacer(modifier = Modifier.height(48.dp))

        // Update Button
        Button(
            onClick = {
                val intent = Intent(Intent.ACTION_VIEW, Uri.parse(state.updateUrl))
                context.startActivity(intent)
            },
            modifier = Modifier
                .fillMaxWidth()
                .height(56.dp),
            shape = RoundedCornerShape(12.dp),
            colors = ButtonDefaults.buttonColors(
                containerColor = Color(0xFFFF9800)
            )
        ) {
            Text(
                text = stringResource(R.string.force_update_button),
                style = MaterialTheme.typography.bodyLarge.copy(
                    fontWeight = FontWeight.Bold,
                    color = Color.White
                )
            )
        }
    }
}

