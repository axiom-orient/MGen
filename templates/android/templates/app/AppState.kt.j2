package {{ cookiecutter.base_package }}

import android.content.Context
import android.util.Log
import androidx.datastore.core.DataStore
import androidx.datastore.preferences.core.*
import androidx.datastore.preferences.preferencesDataStore
import dagger.hilt.android.qualifiers.ApplicationContext
import kotlinx.coroutines.flow.Flow
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.flow.catch
import kotlinx.coroutines.flow.first
import kotlinx.coroutines.flow.map
import {{ cookiecutter.base_package }}.core.network.NetworkMonitor
import {{ cookiecutter.base_package }}.core.network.NetworkState
import {{ cookiecutter.base_package }}.core.remoteconfig.LocalizedRemoteConfig
import {{ cookiecutter.base_package }}.core.remoteconfig.RemoteConfigKeys
import {{ cookiecutter.base_package }}.core.remoteconfig.RemoteConfigRepository
import kotlinx.coroutines.CoroutineScope
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.SupervisorJob
import kotlinx.coroutines.flow.SharingStarted
import kotlinx.coroutines.flow.stateIn
import javax.inject.Inject
import javax.inject.Singleton

/**
 * DataStore preferences extension for Application context.
 */
private val Context.dataStore: DataStore<Preferences> by preferencesDataStore(name = "app_state")

/**
 * Centralized app state manager with Kotlin 1.9+ best practices.
 *
 * Manages both volatile (in-memory) and persistent (DataStore Preferences) state
 * with type-safe reactive programming patterns.
 *
 * ## Architecture
 * - **Volatile State**: MutableStateFlow for in-memory session state
 * - **Persistent State**: DataStore Preferences with Flow-based reactive access
 * - **Error Handling**: Result monad for all write operations
 * - **Coroutines**: Suspend functions for async operations
 *
 * ## Design Philosophy
 * - Mirrors iOS swift-sharing pattern for platform parity
 * - Uses Jetpack DataStore for type-safe, async persistence
 * - Exposes all state as Flow for reactive consumption
 * - No blocking operations - all DataStore access is suspend-based
 * - Comprehensive error handling with Result<T>
 *
 * ## Usage Examples
 * ```kotlin
 * @Inject lateinit var appState: AppState
 *
 * // Volatile state (in-memory)
 * val tabIndex = appState.selectedTabIndex.value
 * appState.setSelectedTabIndex(1)
 *
 * // Persistent state (reactive Flow)
 * viewModel.viewModelScope.launch {
 *     appState.forceUpdateMinimumVersion.collect { version ->
 *         // React to version changes
 *     }
 * }
 *
 * // Write with error handling
 * viewModel.viewModelScope.launch {
 *     appState.setUserId("user123")
 *         .onSuccess { Log.d(TAG, "User ID saved") }
 *         .onFailure { Log.e(TAG, "Failed to save", it) }
 * }
 *
 * // Sync from Remote Config
 * viewModel.viewModelScope.launch {
 *     appState.syncFromRemoteConfig(remoteConfigRepository)
 *         .onSuccess { Log.d(TAG, "Config synced") }
 *         .onFailure { Log.e(TAG, "Sync failed", it) }
 * }
 * ```
 *
 * @property context Application context for DataStore access
 * @property networkMonitor Network state monitoring
 * @property localizedRemoteConfig Localization support
 */
@Singleton
public class AppState @Inject constructor(
    @ApplicationContext private val context: Context,
    private val networkMonitor: NetworkMonitor,
    private val localizedRemoteConfig: LocalizedRemoteConfig
) {
    private val dataStore: DataStore<Preferences> = context.dataStore

    /**
     * Coroutine scope for StateFlow transformations.
     * Uses SupervisorJob to prevent cascading cancellations.
     */
    private val coroutineScope: CoroutineScope = CoroutineScope(SupervisorJob() + Dispatchers.Default)

    public companion object {
        private const val TAG = "AppState"

        /**
         * DataStore preference keys.
         * Centralized key definitions for type safety.
         */
        private object PrefsKeys {
            val FORCE_UPDATE_MIN_VERSION = stringPreferencesKey("forceUpdateMinVersion")
            val MAINTENANCE_MODE = booleanPreferencesKey("maintenanceMode")
            val MAINTENANCE_MESSAGE = stringPreferencesKey("maintenanceMessage")
            val WELCOME_MESSAGE = stringPreferencesKey("welcomeMessage")
            val LAST_REMOTE_CONFIG_SYNC = longPreferencesKey("lastRemoteConfigSync")
            val IS_FIRST_LAUNCH_COMPLETE = booleanPreferencesKey("isFirstLaunchComplete")
            val USER_LANGUAGE_CODE = stringPreferencesKey("userLanguageCode")
            val USER_ID = stringPreferencesKey("userId")
            val IS_LOGGED_IN = booleanPreferencesKey("isLoggedIn")
            val THEME_MODE = stringPreferencesKey("themeMode")
        }
    }

    // ══════════════════════════════════════════════════════════════
    // 🔧 Customize Per App - Volatile State (In-Memory Only)
    // ══════════════════════════════════════════════════════════════

    private val _selectedTabIndex = MutableStateFlow(0)
    val selectedTabIndex: StateFlow<Int> = _selectedTabIndex.asStateFlow()

    private val _isShowingOnboarding = MutableStateFlow(false)
    val isShowingOnboarding: StateFlow<Boolean> = _isShowingOnboarding.asStateFlow()

    private val _lastViewedScreen = MutableStateFlow("")
    val lastViewedScreen: StateFlow<String> = _lastViewedScreen.asStateFlow()

    private val _isInForeground = MutableStateFlow(true)
    val isInForeground: StateFlow<Boolean> = _isInForeground.asStateFlow()

    private val _latestStoreVersionCode = MutableStateFlow<Int?>(null)
    val latestStoreVersionCode: StateFlow<Int?> = _latestStoreVersionCode.asStateFlow()

    fun setSelectedTabIndex(index: Int) {
        _selectedTabIndex.value = index
    }

    fun setShowingOnboarding(showing: Boolean) {
        _isShowingOnboarding.value = showing
    }

    fun setLastViewedScreen(screen: String) {
        _lastViewedScreen.value = screen
    }

    fun setInForeground(inForeground: Boolean) {
        _isInForeground.value = inForeground
    }

    public fun setLatestStoreVersionCode(versionCode: Int?) {
        _latestStoreVersionCode.value = versionCode
    }

    // ══════════════════════════════════════════════════════════════
    // 📦 Template Core - Persistent State (DataStore Preferences)
    // ══════════════════════════════════════════════════════════════

    /**
     * Force update minimum version (Flow-based reactive access).
     * Matches iOS @Shared(.appStorage(...)) pattern.
     */
    public val forceUpdateMinimumVersion: Flow<String> = dataStore.data.map { prefs ->
        prefs[PrefsKeys.FORCE_UPDATE_MIN_VERSION] ?: ""
    }

    public val isMaintenanceMode: Flow<Boolean> = dataStore.data.map { prefs ->
        prefs[PrefsKeys.MAINTENANCE_MODE] ?: false
    }

    public val maintenanceMessage: Flow<String> = dataStore.data.map { prefs ->
        prefs[PrefsKeys.MAINTENANCE_MESSAGE] ?: ""
    }

    public val welcomeMessage: Flow<String> = dataStore.data.map { prefs ->
        prefs[PrefsKeys.WELCOME_MESSAGE] ?: ""
    }

    public val lastRemoteConfigSyncTimestamp: Flow<Long> = dataStore.data.map { prefs ->
        prefs[PrefsKeys.LAST_REMOTE_CONFIG_SYNC] ?: 0L
    }

    public val userLanguageCode: Flow<String> = dataStore.data.map { prefs ->
        prefs[PrefsKeys.USER_LANGUAGE_CODE] ?: run {
            // Initialize from device language on first access
            val deviceLanguage = context.resources.configuration.locales[0].language
            Log.i(TAG, "Initialized user language: $deviceLanguage")
            deviceLanguage
        }
    }

    // StateFlows for reactive UI updates
    // Explicitly exposing Flow types
    public val userId: Flow<String?> = dataStore.data.map { preferences ->
        preferences[PrefsKeys.USER_ID]
    }

    public val isLoggedIn: Flow<Boolean> = dataStore.data.map { preferences ->
        preferences[PrefsKeys.IS_LOGGED_IN] ?: false
    }

    public val themeMode: Flow<String> = dataStore.data.map { preferences ->
        preferences[PrefsKeys.THEME_MODE] ?: "system"
    }

    public val isNetworkAvailable: Flow<Boolean> = networkMonitor.networkState
        .map { it is NetworkState.Available }
        .stateIn(coroutineScope, SharingStarted.Eagerly, false)

    // ══════════════════════════════════════════════════════════════
    // Write Operations (Result-based for error handling)
    // ══════════════════════════════════════════════════════════════

    /**
     * Sets user ID in persistent storage.
     *
     * @param id User identifier
     * @return Result indicating success or failure
     */
    public suspend fun setUserId(id: String): Result<Unit> = runCatching {
        dataStore.edit { preferences ->
            preferences[PrefsKeys.USER_ID] = id
        }
        Log.d(TAG, "User ID set: $id")
    }

    /**
     * Sets login status in persistent storage.
     *
     * @param loggedIn Whether user is logged in
     * @return Result indicating success or failure
     */
    public suspend fun setLoggedIn(loggedIn: Boolean): Result<Unit> = runCatching {
        dataStore.edit { preferences ->
            preferences[PrefsKeys.IS_LOGGED_IN] = loggedIn
        }
        Log.d(TAG, "Login status set: $loggedIn")
    }

    /**
     * Sets theme mode in persistent storage.
     *
     * @param mode Theme mode ("light", "dark", "system")
     * @return Result indicating success or failure
     */
    public suspend fun setThemeMode(mode: String): Result<Unit> = runCatching {
        dataStore.edit { preferences ->
            preferences[PrefsKeys.THEME_MODE] = mode
        }
        Log.d(TAG, "Theme mode set: $mode")
    }


    // ══════════════════════════════════════════════════════════════
    // 📦 Template Core - Remote Config Sync
    // ══════════════════════════════════════════════════════════════

    /**
     * Synchronizes persistent state from Remote Config values.
     *
     * Call this after successful Remote Config fetch to persist values locally.
     * Uses Result monad for safe error handling.
     *
     * @param repository Remote Config repository to sync from
     * @return Result indicating success or failure
     */
    public suspend fun syncFromRemoteConfig(repository: RemoteConfigRepository): Result<Unit> = runCatching {
        dataStore.edit { prefs ->
            prefs[PrefsKeys.FORCE_UPDATE_MIN_VERSION] = repository.getString(RemoteConfigKeys.FORCE_UPDATE_MIN_VERSION)
            prefs[PrefsKeys.MAINTENANCE_MODE] = repository.getBoolean(RemoteConfigKeys.MAINTENANCE_MODE_ENABLED)
            prefs[PrefsKeys.MAINTENANCE_MESSAGE] = repository.getString(RemoteConfigKeys.MAINTENANCE_MESSAGE)
            prefs[PrefsKeys.WELCOME_MESSAGE] = repository.getString(RemoteConfigKeys.WELCOME_MESSAGE)
            prefs[PrefsKeys.LAST_REMOTE_CONFIG_SYNC] = System.currentTimeMillis()
        }

        Log.i(TAG, "✅ AppState synced from Remote Config")
        Log.d(TAG, "- forceUpdateMinVersion: ${forceUpdateMinimumVersion.first()}")
        Log.d(TAG, "- maintenanceMode: ${isMaintenanceMode.first()}")
    }

    /**
     * Sets user language code in persistent storage.
     *
     * @param languageCode Language code (e.g., "en", "ko", "ja")
     * @return Result indicating success or failure
     */
    public suspend fun setUserLanguageCode(languageCode: String): Result<Unit> = runCatching {
        dataStore.edit { prefs ->
            prefs[PrefsKeys.USER_LANGUAGE_CODE] = languageCode
        }
        Log.d(TAG, "User language code set: $languageCode")
    }

    /**
     * Checks if cached Remote Config values exist.
     *
     * @return true if cache exists, false otherwise
     */
    public suspend fun hasCachedRemoteConfig(): Boolean {
        return lastRemoteConfigSyncTimestamp.first() > 0
    }

    /**
     * Checks if cache is valid (within TTL).
     * Matches iOS behavior: 10 minute TTL.
     *
     * @return true if cache is valid, false otherwise
     */
    public suspend fun isCacheValid(): Boolean {
        if (!hasCachedRemoteConfig()) return false
        val timestamp = lastRemoteConfigSyncTimestamp.first()
        val elapsed = System.currentTimeMillis() - timestamp
        return elapsed < AppConstants.CACHE_TTL_MS
    }

    /**
     * Checks if this is the first launch.
     *
     * @return true if first launch is complete, false otherwise
     */
    public suspend fun isFirstLaunchComplete(): Boolean {
        return dataStore.data.first()[PrefsKeys.IS_FIRST_LAUNCH_COMPLETE] ?: false
    }

    /**
     * Marks first launch as complete.
     *
     * @return Result indicating success or failure
     */
    public suspend fun markFirstLaunchComplete(): Result<Unit> = runCatching {
        dataStore.edit { prefs ->
            prefs[PrefsKeys.IS_FIRST_LAUNCH_COMPLETE] = true
        }
        Log.d(TAG, "First launch marked complete")
    }

    // ══════════════════════════════════════════════════════════════
    // Localized Values
    // ══════════════════════════════════════════════════════════════

    /**
     * Gets localized welcome message based on user's selected language.
     *
     * Falls back to English if localization not available.
     *
     * @return Result containing localized message or error
     */
    public suspend fun getLocalizedWelcomeMessage(): Result<String> = runCatching {
        val langCode = userLanguageCode.first()
        val message = welcomeMessage.first()
        localizedRemoteConfig.localize(message, langCode)
            ?: localizedRemoteConfig.localize(message, "en")
            ?: ""
    }

    /**
     * Gets localized maintenance message based on user's selected language.
     *
     * Falls back to English if localization not available.
     *
     * @return Result containing localized message or error
     */
    public suspend fun getLocalizedMaintenanceMessage(): Result<String> = runCatching {
        val langCode = userLanguageCode.first()
        val message = maintenanceMessage.first()
        localizedRemoteConfig.localize(message, langCode)
            ?: localizedRemoteConfig.localize(message, "en")
            ?: ""
    }

    // ══════════════════════════════════════════════════════════════
    // Reset
    // ══════════════════════════════════════════════════════════════

    /**
     * Resets all volatile state to defaults.
     *
     * Clears in-memory state like selected tab, onboarding status, etc.
     */
    public fun resetVolatileState() {
        _selectedTabIndex.value = 0
        _isShowingOnboarding.value = false
        _lastViewedScreen.value = ""
        _latestStoreVersionCode.value = null
        Log.d(TAG, "Volatile state reset")
    }

    /**
     * Clears all persistent state.
     *
     * **Warning**: This is destructive and cannot be undone.
     * Use only for logout or factory reset scenarios.
     *
     * @return Result indicating success or failure
     */
    public suspend fun clearPersistentState(): Result<Unit> = runCatching {
        dataStore.edit { prefs ->
            prefs.clear()
        }
        Log.w(TAG, "⚠️ Persistent state cleared")
    }
}
