     *
     * One-shot query, does not observe changes.
     * Returns null if item not found.
     *
     * @param id Unique identifier
     * @return Item if found, null otherwise
     */
    public suspend fun getById(id: String): {{ domain_name }}?

    /**
     * Saves (insert or update) a {{ domain_name_lower }} item.
     *
     * If item with same ID exists, updates it. Otherwise inserts new item.
     * Operation is atomic and thread-safe.
     *
     * ## Error Handling
     * Implementations may throw exceptions for:
     * - Network failures (if syncing to server)
     * - Database constraints (if validation fails)
     * - Storage limits (if disk full)
     *
     * Callers should wrap in try-catch or use Result:
     * ```kotlin
     * runCatching { repository.save(item) }
     *     .onSuccess { /* Success */ }
     *     .onFailure { error -> /* Handle error */ }
     * ```
     *
     * @param item Item to save
     * @throws Exception if operation fails
     */
    public suspend fun save(item: {{ domain_name }})

    /**
     * Deletes a {{ domain_name_lower }} by ID.
     *
     * No-op if item doesn't exist (idempotent).
     * Operation is atomic and thread-safe.
     *
     * @param id Unique identifier of item to delete
     * @throws Exception if operation fails
     */
    public suspend fun delete(id: String)

    /**
     * Refreshes data from remote source (if applicable).
     *
     * Fetches latest data from server and updates local cache.
     * Useful for pull-to-refresh functionality.
     *
     * ## Error Handling
     * Returns Result to handle network failures gracefully.
     *
     * @return Result.success if refresh succeeded, Result.failure with exception if failed
     */
    public suspend fun refresh(): Result<Unit> = Result.success(Unit)
