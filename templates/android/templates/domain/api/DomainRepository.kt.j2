/**
 * Repository interface for {{ domain_name }} domain.
 *
 * Defines the contract for data operations in the domain layer.
 * Abstracts data source details (Room, Retrofit, etc.) from domain logic.
 *
 * ## Repository Pattern
 * - **Interface in Domain**: Defines what data operations are needed
 * - **Implementation in Data**: Handles actual data source interactions
 * - **Dependency Inversion**: Domain depends on abstractions, not implementations
 *
 * ## Return Types
 * - **Flow**: For reactive streams that emit updates (e.g., observeAll)
 * - **Result**: For one-shot operations that can fail (fetch, save)
 * - **Direct Types**: For operations guaranteed to succeed (local cache)
 *
 * ## Error Handling
 * Repository implementations should return `Result<T>` for operations that can fail:
 * ```kotlin
 * override suspend fun fetchFromNetwork(): Result<{{ domain_name }}> = runCatching {
 *     api.get{{ domain_name }}()
 * }
 * ```
 *
 * ## Offline-First Pattern
 * Repositories often implement offline-first strategy:
 * 1. Emit cached data immediately via Flow
 * 2. Fetch fresh data from network in background
 * 3. Update cache and Flow emits new data
 *
 * ## Testing
 * Easy to mock for testing:
 * ```kotlin
 * class Fake{{ domain_name }}Repository : {{ domain_name }}Repository {
 *     private val data = mutableListOf<{{ domain_name }}>()
 *     override fun getAll() = flowOf(data)
 * }
 * ```
 *
 * @see {{ domain_name }}
 */
public interface {{ domain_name }}Repository {

    /**
     * Observes all {{ domain_name_lower }} items.
     *
     * Emits new list whenever data changes (insert, update, delete).
     * Flow is infinite and does not complete unless repository is closed.
     *
     * ## Usage
     * ```kotlin
     * repository.getAll()
     *     .map { it.filter { item -> item.isValid() } }
     *     .collect { items -> updateUI(items) }
