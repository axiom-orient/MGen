package {{ cookiecutter.base_package }}.core.database.di

import android.content.Context
import androidx.room.Room
import {{ cookiecutter.base_package }}.core.database.AppDatabase
import {{ cookiecutter.base_package }}.core.database.dao.SampleDao
import dagger.Module
import dagger.Provides
import dagger.hilt.InstallIn
import dagger.hilt.android.qualifiers.ApplicationContext
import dagger.hilt.components.SingletonComponent
import javax.inject.Singleton

@Module
@InstallIn(SingletonComponent::class)
object DatabaseModule {

    @Provides
    @Singleton
    fun provideDatabase(
        @ApplicationContext context: Context
    ): AppDatabase {
        return Room.databaseBuilder(
            context,
            AppDatabase::class.java,
            "app.db"
        ).fallbackToDestructiveMigration().build()
    }

    @Provides
    fun provideSampleDao(database: AppDatabase): SampleDao = database.sampleDao()
}
