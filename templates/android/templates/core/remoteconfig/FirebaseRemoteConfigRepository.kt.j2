package {{ cookiecutter.base_package }}.core.remoteconfig

import android.util.Log
import com.google.firebase.remoteconfig.FirebaseRemoteConfig
import com.google.firebase.remoteconfig.FirebaseRemoteConfigSettings
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.suspendCancellableCoroutine
import kotlinx.coroutines.withContext
import javax.inject.Inject
import javax.inject.Singleton
import {{ cookiecutter.base_package }}.core.data.BuildConfig
import kotlin.coroutines.resume
import kotlin.coroutines.resumeWithException

/**
 * Firebase Remote Config implementation.
 * 
 * Production-ready implementation with:
 * - **Timeout handling**: 60-second fetch timeout
 * - **Smart caching**: Debug (0s) vs Release (1h) intervals
 * - **Error recovery**: Graceful fallback to defaults
 * - **Result-based API**: Type-safe error handling
 * 
 * ## Configuration
 * - Debug: Instant fetch for rapid development
 * - Release: 1-hour cache for production efficiency
 * 
 * @see RemoteConfigRepository
 * @see LocalRemoteConfigRepository
 */
@Singleton
public class FirebaseRemoteConfigRepository @Inject constructor() : RemoteConfigRepository {

    private val remoteConfig: FirebaseRemoteConfig = FirebaseRemoteConfig.getInstance()

    private companion object {
        private const val TAG = "FirebaseRemoteConfig"
        private const val FETCH_TIMEOUT_SECONDS = 60L
        private const val MINIMUM_FETCH_INTERVAL_DEBUG = 0L
        private const val MINIMUM_FETCH_INTERVAL_RELEASE = 3600L // 1 hour
    }

    init {
        val configSettings = FirebaseRemoteConfigSettings.Builder()
            .setFetchTimeoutInSeconds(FETCH_TIMEOUT_SECONDS)
            .setMinimumFetchIntervalInSeconds(
                if (BuildConfig.DEBUG) {
                    MINIMUM_FETCH_INTERVAL_DEBUG
                } else {
                    MINIMUM_FETCH_INTERVAL_RELEASE
                }
            )
            .build()

        remoteConfig.setConfigSettingsAsync(configSettings)
        remoteConfig.setDefaultsAsync(RemoteConfigDefaults.defaults)

        Log.d(TAG, "Firebase Remote Config initialized (debug=${BuildConfig.DEBUG}, interval=${if (BuildConfig.DEBUG) 0 else 3600}s)")
    }

    override suspend fun fetchAndActivate(): Result<Unit> = withContext(Dispatchers.IO) {
        runCatching {
            Log.d(TAG, "🔄 Fetching remote config...")
            
            val success = suspendCancellableCoroutine { continuation ->
                remoteConfig.fetchAndActivate()
                    .addOnSuccessListener { activated ->
                        Log.d(TAG, "✅ Fetch complete (activated=$activated)")
                        continuation.resume(activated)
                    }
                    .addOnFailureListener { error ->
                        Log.e(TAG, "❌ Fetch failed: ${error.message}", error)
                        continuation.resumeWithException(error)
                    }
                    .addOnCanceledListener {
                        Log.w(TAG, "⚠️ Fetch canceled")
                        continuation.resumeWithException(
                            Exception("Remote config fetch canceled")
                        )
                    }
            }
            
            Unit // Return Unit on success
        }.recoverCatching { error ->
            // Convert to RemoteConfigError
            throw when {
                error.message?.contains("network", ignoreCase = true) == true ->
                    RemoteConfigError.NetworkError(error)
                else -> RemoteConfigError.General("Fetch failed", error)
            }
        }
    }

    override suspend fun getString(key: RemoteConfigKey): Result<String> = runCatching {
        remoteConfig.getString(key.key)
    }

    override suspend fun getBoolean(key: RemoteConfigKey): Result<Boolean> = runCatching {
        remoteConfig.getBoolean(key.key)
    }

    override suspend fun getLong(key: RemoteConfigKey): Result<Long> = runCatching {
        remoteConfig.getLong(key.key)
    }

    override suspend fun getDouble(key: RemoteConfigKey): Result<Double> = runCatching {
        remoteConfig.getDouble(key.key)
    }

    // Legacy synchronous methods for backward compatibility
    override fun getString(key: String): String {
        return remoteConfig.getString(key)
    }

    override fun getBoolean(key: String): Boolean {
        return remoteConfig.getBoolean(key)
    }

    override fun getLong(key: String): Long {
        return remoteConfig.getLong(key)
    }

    override fun getDouble(key: String): Double {
        return remoteConfig.getDouble(key)
    }
}
