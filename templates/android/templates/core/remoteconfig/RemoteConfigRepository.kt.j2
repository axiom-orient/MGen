package {{ cookiecutter.base_package }}.core.remoteconfig

/**
 * Remote Configuration Repository interface.
 * Android equivalent of iOS RemoteConfigService protocol.
 *
 * Provides a unified interface for accessing remote configuration values
 * regardless of the underlying implementation (Firebase, local, etc.).
 *
 * Note: Caching is handled by AppState singleton for centralized state management.
 */
interface RemoteConfigRepository {

    /**
     * Fetch and activate remote configuration values.
     * This is a suspend function that should be called during app initialization.
     *
     * @throws RemoteConfigException if fetch fails and no defaults are available
     */
    public suspend fun fetchAndActivate()

    /**
     * Get a string value for the given key.
     *
     * @param key The configuration key
     * @return The string value, or empty string if not found
     */
    public fun getString(key: String): String

    /**
     * Get a boolean value for the given key.
     *
     * @param key The configuration key
     * @return The boolean value, or false if not found
     */
    public fun getBoolean(key: String): Boolean

    /**
     * Get a long value for the given key.
     *
     * @param key The configuration key
     * @return The long value, or 0 if not found
     */
    public fun getLong(key: String): Long

    /**
     * Get a double value for the given key.
     *
     * @param key The configuration key
     * @return The double value, or 0.0 if not found
     */
    public fun getDouble(key: String): Double
}

/**
 * Exception thrown when remote config operations fail.
 */
public class RemoteConfigException(
    message: String,
    cause: Throwable? = null
) : Exception(message, cause)

/**
 * Common remote config keys used across the app.
 * Keys are aligned with iOS for Firebase Console consistency.
 *
 * Note: latest_app_version is NOT included here - it's fetched
 * directly from the Play Store using StoreVersionChecker.
 */
public object RemoteConfigKeys {
    // Force Update
    public const val FORCE_UPDATE_MIN_VERSION: String = "force_update_min_version"

    // Maintenance Mode
    public const val MAINTENANCE_MODE_ENABLED: String = "maintenance_mode_enabled"
    public const val MAINTENANCE_MESSAGE: String = "maintenance_message"

    // Content
    public const val WELCOME_MESSAGE: String = "welcome_message"
}

/**
