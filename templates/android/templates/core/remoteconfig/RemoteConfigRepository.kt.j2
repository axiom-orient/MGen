    /**
     * Gets default value for a specific key with type safety.
     * 
     * @param key The configuration key
     * @return Default value, or null if not found
     */
    @Suppress("UNCHECKED_CAST")
    public inline fun <reified T> getDefault(key: RemoteConfigKey): T? {
        return defaults[key.key] as? T
    }
}
