package {{ cookiecutter.base_package }}.core.remoteconfig

/**
 * Remote Configuration Repository interface.
 * 
 * Provides type-safe, coroutine-based access to remote configuration values
 * with comprehensive error handling and caching support.
 * 
 * ## Architecture
 * - **Thread-safe**: All operations are thread-safe and properly synchronized
 * - **Offline-first**: Caches values locally for offline access
 * - **Type-safe**: Uses sealed classes for configuration keys
 * - **Error handling**: Returns `Result<T>` for all failable operations
 * 
 * ## Usage
 * ```kotlin
 * class MyViewModel @Inject constructor(
 *     private val remoteConfig: RemoteConfigRepository
 * ) : ViewModel() {
 *     fun loadConfig() {
 *         viewModelScope.launch {
 *             remoteConfig.fetchAndActivate()
 *                 .onSuccess { /* Config loaded */ }
 *                 .onFailure { error -> /* Handle error */ }
 *             
 *             val version = remoteConfig.getString(RemoteConfigKey.ForceUpdateMinVersion)
 *                 .getOrDefault("")
 *         }
 *     }
 * }
 * ```
 * 
 * @see RemoteConfigKey
 * @see FirebaseRemoteConfigRepository
 * @see LocalRemoteConfigRepository
 */
public interface RemoteConfigRepository {

    /**
     * Fetches and activates remote configuration values.
     * 
     * This operation:
     * 1. Fetches latest values from remote source
     * 2. Activates them for immediate use
     * 3. Caches them locally for offline access
     * 
     * **Thread-safety**: Safe to call from any coroutine context.
     * Will automatically switch to IO dispatcher internally.
     * 
     * @return [Result.success] if fetch succeeds or cached values are available,
     *         [Result.failure] if fetch fails and no cache exists
     */
    public suspend fun fetchAndActivate(): Result<Unit>

    /**
     * Retrieves a string configuration value.
     * 
     * @param key The configuration key to retrieve
     * @return [Result] containing the string value, or error if retrieval fails.
     *         Returns empty string if key not found (not an error).
     */
    public suspend fun getString(key: RemoteConfigKey): Result<String>

    /**
     * Retrieves a boolean configuration value.
     * 
     * @param key The configuration key to retrieve
     * @return [Result] containing the boolean value, or error if retrieval fails.
     *         Returns false if key not found (not an error).
     */
    public suspend fun getBoolean(key: RemoteConfigKey): Result<Boolean>

    /**
     * Retrieves a long configuration value.
     * 
     * @param key The configuration key to retrieve
     * @return [Result] containing the long value, or error if retrieval fails.
     *         Returns 0L if key not found (not an error).
     */
    public suspend fun getLong(key: RemoteConfigKey): Result<Long>

    /**
     * Retrieves a double configuration value.
     * 
     * @param key The configuration key to retrieve
     * @return [Result] containing the double value, or error if retrieval fails.
     *         Returns 0.0 if key not found (not an error).
     */
    public suspend fun getDouble(key: RemoteConfigKey): Result<Double>
    
    // Legacy synchronous methods for backward compatibility
    public fun getString(key: String): String
    public fun getBoolean(key: String): Boolean
    public fun getLong(key: String): Long
    public fun getDouble(key: String): Double
}

/**
 * Type-safe remote configuration keys.
 * 
 * Using sealed class provides:
 * - **Type safety**: Compile-time verification of keys
 * - **Exhaustive when**: Compiler enforces handling all cases
 * - **IDE support**: Auto-completion and refactoring
 * 
 * ## Adding New Keys
 * ```kotlin
 * data object NewFeatureFlag : RemoteConfigKey("new_feature_flag")
 * ```
 * 
 * @property key The raw string key used in remote configuration
 */
public sealed class RemoteConfigKey(public val key: String) {
    /** Force update minimum version requirement */
    public data object ForceUpdateMinVersion : RemoteConfigKey("force_update_min_version")
    
    /** Maintenance mode enabled flag */
    public data object MaintenanceModeEnabled : RemoteConfigKey("maintenance_mode_enabled")
    
    /** Maintenance mode message (JSON multilingual) */
    public data object MaintenanceMessage : RemoteConfigKey("maintenance_message")
    
    /** Welcome message (JSON multilingual) */
    public data object WelcomeMessage : RemoteConfigKey("welcome_message")
    
    public companion object {
        /**
         * All available configuration keys.
         * Useful for iteration and validation.
         */
        public val all: List<RemoteConfigKey> = listOf(
            ForceUpdateMinVersion,
            MaintenanceModeEnabled,
            MaintenanceMessage,
            WelcomeMessage
        )
        
        /**
         * Creates a RemoteConfigKey from a string.
         * Used for backward compatibility and dynamic key access.
         * 
         * @param keyString The raw configuration key
         * @return Matching RemoteConfigKey, or throws if not found
         * @throws IllegalArgumentException if key is not recognized
         */
        public fun fromString(keyString: String): RemoteConfigKey {
            return all.firstOrNull { it.key == keyString }
                ?: throw IllegalArgumentException("Unknown remote config key: $keyString")
        }
    }
}

/**
 * Legacy string constants for remote config keys.
 * 
 * **Deprecated**: Use [RemoteConfigKey] sealed class instead for type safety.
 * 
 * @see RemoteConfigKey
 */
@Deprecated(
    message = "Use RemoteConfigKey sealed class instead",
    replaceWith = ReplaceWith("RemoteConfigKey")
)
public object RemoteConfigKeys {
    public const val FORCE_UPDATE_MIN_VERSION: String = "force_update_min_version"
    public const val MAINTENANCE_MODE_ENABLED: String = "maintenance_mode_enabled"
    public const val MAINTENANCE_MESSAGE: String = "maintenance_message"
    public const val WELCOME_MESSAGE: String = "welcome_message"
}

/**
 * Remote configuration error types.
 * 
 * Provides detailed error information for better error handling and debugging.
 */
public sealed class RemoteConfigError : Exception() {
    /**
     * Network error during fetch operation.
     * 
     * @property cause The underlying network exception
     */
    public data class NetworkError(
        override val cause: Throwable
    ) : RemoteConfigError() {
        override val message: String = "Network error during config fetch: ${cause.message}"
    }
    
    /**
     * Configuration value parsing error.
     * 
     * @property key The configuration key that failed to parse
     * @property expectedType The expected value type
     */
    public data class ParseError(
        public val key: String,
        public val expectedType: String,
        override val cause: Throwable? = null
    ) : RemoteConfigError() {
        override val message: String = "Failed to parse config key '$key' as $expectedType"
    }
    
    /**
     * Configuration not initialized.
     * Fetch must be called before accessing values.
     */
    public data object NotInitialized : RemoteConfigError() {
        override val message: String = "Remote config not initialized. Call fetchAndActivate() first."
    }
    
    /**
     * General configuration error.
     * 
     * @property reason Human-readable error description
     */
    public data class General(
        public val reason: String,
        override val cause: Throwable? = null
    ) : RemoteConfigError() {
        override val message: String = reason
    }
}

/**
 * Legacy exception type for backward compatibility.
 * 
 * **Deprecated**: Use [RemoteConfigError] sealed class instead.
 */
@Deprecated(
    message = "Use RemoteConfigError sealed class instead",
    replaceWith = ReplaceWith("RemoteConfigError")
)
public class RemoteConfigException(
    message: String,
    cause: Throwable? = null
) : Exception(message, cause)

