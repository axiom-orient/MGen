package {{ cookiecutter.base_package }}.core.remoteconfig.di

import {{ cookiecutter.base_package }}.core.remoteconfig.RemoteConfigRepository
import {{ cookiecutter.base_package }}.core.remoteconfig.DefaultUpdateChecker
import {{ cookiecutter.base_package }}.core.remoteconfig.UpdateChecker
import {{ cookiecutter.base_package }}.core.remoteconfig.FirebaseRemoteConfigRepository
import dagger.Binds
import dagger.Module
import dagger.hilt.InstallIn
import dagger.hilt.components.SingletonComponent
import javax.inject.Singleton

/**
 * Hilt DI module for Remote Config dependencies.
 * 
 * Provides:
 * - [RemoteConfigRepository]: Firebase-based configuration (production)
 * - [UpdateChecker]: Version comparison and update detection
 * 
 * ## Configuration Strategy
 * 
 * **Production**: Uses [FirebaseRemoteConfigRepository] for live remote config
 * **Testing**: Swap binding to [LocalRemoteConfigRepository] for offline tests
 * 
 * ## Dependency Graph
 * ```
 * RemoteConfigRepository (interface)
 *   ├─ FirebaseRemoteConfigRepository (prod)
 *   └─ LocalRemoteConfigRepository (test/offline)
 * 
 * UpdateChecker (interface)
 *   └─ DefaultUpdateChecker (implementation)
 * ```
 * 
 * @see RemoteConfigRepository
 * @see UpdateChecker
 */
@Module
@InstallIn(SingletonComponent::class)
public abstract class RemoteConfigModule {

    /**
     * Binds Firebase implementation as the default Remote Config repository.
     * 
     * For testing or offline scenarios, replace with [LocalRemoteConfigRepository]:
     * ```kotlin
     * @TestInstallIn(
     *     components = [SingletonComponent::class],
     *     replaces = [RemoteConfigModule::class]
     * )
     * ```
     */
    @Binds
    @Singleton
    public abstract fun bindRemoteConfigRepository(
        impl: FirebaseRemoteConfigRepository
    ): RemoteConfigRepository

    /**
     * Binds the default update checker implementation.
     * 
     * Provides semantic versioning comparison and Play Store URL generation.
     */
    @Binds
    @Singleton
    public abstract fun bindUpdateChecker(
        impl: DefaultUpdateChecker
    ): UpdateChecker
}
