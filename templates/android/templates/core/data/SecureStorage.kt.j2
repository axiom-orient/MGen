package {{ cookiecutter.base_package }}.core.data

import android.content.Context
import android.content.SharedPreferences
import android.util.Log
import androidx.core.content.edit
import androidx.security.crypto.EncryptedSharedPreferences
import androidx.security.crypto.MasterKey
import dagger.hilt.android.qualifiers.ApplicationContext
import kotlinx.coroutines.channels.awaitClose
import kotlinx.coroutines.flow.Flow
import kotlinx.coroutines.flow.callbackFlow
import kotlinx.coroutines.flow.distinctUntilChanged
import javax.inject.Inject
import javax.inject.Singleton

/**
 * Secure storage interface for sensitive data.
 *
 * Provides encrypted storage for sensitive information like:
 * - Authentication tokens
 * - User credentials
 * - API keys
 * - Personal identifiable information (PII)
 *
 * ## Security Features
 * - **AES-256 GCM encryption**: Military-grade encryption for values
 * - **AES-256 SIV encryption**: Deterministic encryption for keys
 * - **Hardware-backed keys**: Uses Android Keystore when available
 * - **Key derivation**: Secure key generation from master key
 *
 * ## Usage
 * ```kotlin
 * @Inject lateinit var secureStorage: SecureStorage
 *
 * // Store sensitive data
 * secureStorage.putString("auth_token", token)
 *     .onSuccess { Log.d(TAG, "Token saved") }
 *     .onFailure { Log.e(TAG, "Failed to save token", it) }
 *
 * // Retrieve sensitive data
 * val token = secureStorage.getString("auth_token")
 *     .getOrNull()
 *
 * // Observe changes
 * secureStorage.observeString("auth_token")
 *     .collect { token ->
 *         // React to token changes
 *     }
 * ```
 *
 * ## Error Handling
 * All operations return `Result<T>` for safe error handling.
 * Possible errors:
 * - Encryption/decryption failures
 * - Key generation failures
 * - Storage access errors
 *
 * @see EncryptedSecureStorage
 */
public interface SecureStorage {

    // ══════════════════════════════════════════════════════════════
    // Write Operations (Result-based for error handling)
    // ══════════════════════════════════════════════════════════════

    /**
     * Stores a string value securely.
     *
     * @param key Storage key (will be encrypted)
     * @param value Value to store (will be encrypted)
     * @return Result indicating success or failure
     */
    public fun putString(key: String, value: String): Result<Unit>

    /**
     * Stores an integer value securely.
     *
     * @param key Storage key
     * @param value Value to store
     * @return Result indicating success or failure
     */
    public fun putInt(key: String, value: Int): Result<Unit>

    /**
     * Stores a long value securely.
     *
     * @param key Storage key
     * @param value Value to store
     * @return Result indicating success or failure
     */
    public fun putLong(key: String, value: Long): Result<Unit>

    /**
     * Stores a float value securely.
     *
     * @param key Storage key
     * @param value Value to store
     * @return Result indicating success or failure
     */
    public fun putFloat(key: String, value: Float): Result<Unit>

    /**
     * Stores a boolean value securely.
     *
     * @param key Storage key
     * @param value Value to store
     * @return Result indicating success or failure
     */
    public fun putBoolean(key: String, value: Boolean): Result<Unit>

    // ══════════════════════════════════════════════════════════════
    // Read Operations (Result-based with default values)
    // ══════════════════════════════════════════════════════════════

    /**
     * Retrieves a string value.
     *
     * @param key Storage key
     * @param defaultValue Default value if key not found
     * @return Result containing value or error
     */
    public fun getString(key: String, defaultValue: String? = null): Result<String?>

    /**
     * Retrieves an integer value.
     *
     * @param key Storage key
     * @param defaultValue Default value if key not found
     * @return Result containing value or error
     */
    public fun getInt(key: String, defaultValue: Int = 0): Result<Int>

    /**
     * Retrieves a long value.
     *
     * @param key Storage key
     * @param defaultValue Default value if key not found
     * @return Result containing value or error
     */
    public fun getLong(key: String, defaultValue: Long = 0L): Result<Long>

    /**
     * Retrieves a float value.
     *
     * @param key Storage key
     * @param defaultValue Default value if key not found
     * @return Result containing value or error
     */
    public fun getFloat(key: String, defaultValue: Float = 0f): Result<Float>

    /**
     * Retrieves a boolean value.
     *
     * @param key Storage key
     * @param defaultValue Default value if key not found
     * @return Result containing value or error
     */
    public fun getBoolean(key: String, defaultValue: Boolean = false): Result<Boolean>

    // ══════════════════════════════════════════════════════════════
    // Observation (Flow-based for reactive updates)
    // ══════════════════════════════════════════════════════════════

    /**
     * Observes string value changes.
     *
     * Emits new value whenever it changes.
     *
     * @param key Storage key to observe
     * @param defaultValue Default value if key not found
     * @return Flow emitting values
     */
    public fun observeString(key: String, defaultValue: String? = null): Flow<String?>

    /**
     * Observes boolean value changes.
     *
     * @param key Storage key to observe
     * @param defaultValue Default value if key not found
     * @return Flow emitting values
     */
    public fun observeBoolean(key: String, defaultValue: Boolean = false): Flow<Boolean>

    // ══════════════════════════════════════════════════════════════
    // Management Operations
    // ══════════════════════════════════════════════════════════════

    /**
     * Removes a value.
     *
     * @param key Key to remove
     * @return Result indicating success or failure
     */
    public fun remove(key: String): Result<Unit>

    /**
     * Clears all stored values.
     *
     * **Warning**: This is destructive and cannot be undone.
     *
     * @return Result indicating success or failure
     */
    public fun clear(): Result<Unit>

    /**
     * Checks if a key exists.
     *
     * @param key Key to check
     * @return true if key exists, false otherwise
     */
    public fun contains(key: String): Boolean
}

/**
 * Encrypted implementation using Android EncryptedSharedPreferences.
 *
 * Production-ready secure storage with:
 * - **AES-256 GCM encryption**: For preference values
 * - **AES-256 SIV encryption**: For preference keys
 * - **Hardware-backed keys**: Uses Android Keystore when available
 * - **Automatic key generation**: Creates master key on first use
 *
 * ## Encryption Details
 * - Master key stored in Android Keystore (hardware-backed on supported devices)
 * - Each preference key is encrypted with AES256-SIV (deterministic)
 * - Each preference value is encrypted with AES256-GCM (randomized)
 * - Encryption is transparent to the application
 *
 * ## Thread Safety
 * All operations are thread-safe thanks to underlying SharedPreferences.
 *
 * ## Error Recovery
 * If encryption fails, operations return Result.failure with error details.
 * The storage remains in consistent state - partial writes are atomic.
 *
 * @property context Application context
 */
@Singleton
public class EncryptedSecureStorage @Inject constructor(
    @ApplicationContext private val context: Context
) : SecureStorage {

    private val sharedPreferences: SharedPreferences by lazy {
        try {
            val masterKey = MasterKey.Builder(context)
                .setKeyScheme(MasterKey.KeyScheme.AES256_GCM)
                .build()

            EncryptedSharedPreferences.create(
                context,
                PREFS_NAME,
                masterKey,
                EncryptedSharedPreferences.PrefKeyEncryptionScheme.AES256_SIV,
                EncryptedSharedPreferences.PrefValueEncryptionScheme.AES256_GCM
            ).also {
                Log.i(TAG, "Encrypted storage initialized successfully")
            }
        } catch (e: Exception) {
            Log.e(TAG, "Failed to initialize encrypted storage", e)
            throw StorageInitializationException("Failed to initialize secure storage", e)
        }
    }

    private val changeListener = SharedPreferences.OnSharedPreferenceChangeListener { _, _ ->
        // Listener for Flow observations
    }

    init {
        // Register listener for observations
        sharedPreferences.registerOnSharedPreferenceChangeListener(changeListener)
    }

    // ══════════════════════════════════════════════════════════════
    // Write Operations
    // ══════════════════════════════════════════════════════════════

    override fun putString(key: String, value: String): Result<Unit> = runCatching {
        sharedPreferences.edit(commit = true) {
            putString(key, value)
        }
        Log.d(TAG, "Stored string for key: $key")
    }

    override fun putInt(key: String, value: Int): Result<Unit> = runCatching {
        sharedPreferences.edit(commit = true) {
            putInt(key, value)
        }
        Log.d(TAG, "Stored int for key: $key")
    }

    override fun putLong(key: String, value: Long): Result<Unit> = runCatching {
        sharedPreferences.edit(commit = true) {
            putLong(key, value)
        }
        Log.d(TAG, "Stored long for key: $key")
    }

    override fun putFloat(key: String, value: Float): Result<Unit> = runCatching {
        sharedPreferences.edit(commit = true) {
            putFloat(key, value)
        }
        Log.d(TAG, "Stored float for key: $key")
    }

    override fun putBoolean(key: String, value: Boolean): Result<Unit> = runCatching {
        sharedPreferences.edit(commit = true) {
            putBoolean(key, value)
        }
        Log.d(TAG, "Stored boolean for key: $key")
    }

    // ══════════════════════════════════════════════════════════════
    // Read Operations
    // ══════════════════════════════════════════════════════════════

    override fun getString(key: String, defaultValue: String?): Result<String?> = runCatching {
        sharedPreferences.getString(key, defaultValue)
    }

    override fun getInt(key: String, defaultValue: Int): Result<Int> = runCatching {
        sharedPreferences.getInt(key, defaultValue)
    }

    override fun getLong(key: String, defaultValue: Long): Result<Long> = runCatching {
        sharedPreferences.getLong(key, defaultValue)
    }

    override fun getFloat(key: String, defaultValue: Float): Result<Float> = runCatching {
        sharedPreferences.getFloat(key, defaultValue)
    }

    override fun getBoolean(key: String, defaultValue: Boolean): Result<Boolean> = runCatching {
        sharedPreferences.getBoolean(key, defaultValue)
    }

    // ══════════════════════════════════════════════════════════════
    // Observation
    // ══════════════════════════════════════════════════════════════

    override fun observeString(key: String, defaultValue: String?): Flow<String?> = callbackFlow {
        val listener = SharedPreferences.OnSharedPreferenceChangeListener { _, changedKey ->
            if (changedKey == key) {
                val value = sharedPreferences.getString(key, defaultValue)
                trySend(value)
            }
        }

        sharedPreferences.registerOnSharedPreferenceChangeListener(listener)

        // Emit current value
        val currentValue = sharedPreferences.getString(key, defaultValue)
        send(currentValue)

        awaitClose {
            sharedPreferences.unregisterOnSharedPreferenceChangeListener(listener)
        }
    }.distinctUntilChanged()

    override fun observeBoolean(key: String, defaultValue: Boolean): Flow<Boolean> = callbackFlow {
        val listener = SharedPreferences.OnSharedPreferenceChangeListener { _, changedKey ->
            if (changedKey == key) {
                val value = sharedPreferences.getBoolean(key, defaultValue)
                trySend(value)
            }
        }

        sharedPreferences.registerOnSharedPreferenceChangeListener(listener)

        // Emit current value
        val currentValue = sharedPreferences.getBoolean(key, defaultValue)
        send(currentValue)

        awaitClose {
            sharedPreferences.unregisterOnSharedPreferenceChangeListener(listener)
        }
    }.distinctUntilChanged()

    // ══════════════════════════════════════════════════════════════
    // Management Operations
    // ══════════════════════════════════════════════════════════════

    override fun remove(key: String): Result<Unit> = runCatching {
        sharedPreferences.edit(commit = true) {
            remove(key)
        }
        Log.d(TAG, "Removed key: $key")
    }

    override fun clear(): Result<Unit> = runCatching {
        sharedPreferences.edit(commit = true) {
            clear()
        }
        Log.w(TAG, "Cleared all secure storage")
    }

    override fun contains(key: String): Boolean {
        return sharedPreferences.contains(key)
    }

    private companion object {
        private const val TAG = "SecureStorage"
        private const val PREFS_NAME = "secure_prefs"
    }
}

/**
 * Exception thrown when secure storage initialization fails.
 *
 * This typically indicates:
 * - Android Keystore is unavailable
 * - Device is locked and keys are unavailable
 * - Encryption library initialization failed
 *
 * @property message Error description
 * @property cause Underlying exception
 */
public class StorageInitializationException(
    message: String,
    cause: Throwable? = null
) : Exception(message, cause)
