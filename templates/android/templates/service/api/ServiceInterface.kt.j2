 * ```kotlin
 * sealed class {{ service_name }}Error : Exception() {
 *     data class Network(override val cause: Throwable?) : {{ service_name }}Error()
 *     data class Http(val code: Int, val message: String) : {{ service_name }}Error()
 *     data class Parsing(override val cause: Throwable?) : {{ service_name }}Error()
 *     data class Auth(val reason: String) : {{ service_name }}Error()
