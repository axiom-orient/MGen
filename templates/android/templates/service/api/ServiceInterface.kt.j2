 * ```kotlin
 * interface {{ service_name }}Api {
 *     @GET("{{ service_name_lower }}")
 *     suspend fun fetch(): {{ service_name }}ResponseDto
 *
 *     @POST("{{ service_name_lower }}")
 *     suspend fun create(@Body request: {{ service_name }}RequestDto): Unit
 * }
 *
 * class Live{{ service_name }}Service @Inject constructor(
 *     private val api: {{ service_name }}Api
 * ) : {{ service_name }}Service {
 *     override suspend fun fetch() = runCatching {
 *         api.fetch().toResponse()
 *     }
 * }
 * ```
