import Foundation

public enum AppConstants {
  /// Remote Config keys - aligned across iOS and Android.
  /// Note: latest_app_version is NOT included here - it's fetched
  /// directly from the App Store using StoreVersionChecker.
  public enum RemoteConfig {
    public static let forceUpdateMinimumVersionKey = "force_update_min_version"
    public static let welcomeMessageKey = "welcome_message"
    public static let maintenanceModeEnabledKey = "maintenance_mode_enabled"
    public static let maintenanceMessageKey = "maintenance_message"
  }

  public enum Analytics {
    public static let sampleEventName = "app_sample_event"
    public static let sampleEventSourceKey = "source"
  }

  /// App-specific constants
  public enum App {
    /// App Store ID for this app. Set this value for Force Update functionality.
    /// Example: "1234567890"
    public static let appStoreId = "{{ appStoreId }}"

    /// Bundle ID prefix (e.g., "com.axiomorient")
    public static let bundleIdPrefix = "{{ bundleIdPrefix }}"

    /// App name
    public static let appName = "{{ name }}"

    /// App Store URL for Force Update
    public static var appStoreURL: URL {
      if appStoreId.isEmpty {
        return URL(string: "https://apps.apple.com")!
      }
      return URL(string: "https://apps.apple.com/app/id\(appStoreId)")!
    }
  }
}
